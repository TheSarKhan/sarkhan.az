# Server configuration
PORT=3001
HOST=127.0.0.1

# Cloudflare Turnstile widget and server key
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=sarkhan.az,www.sarkhan.az

# ------------------------------------------------------------------
# Option 1: WalletWallet.dev API (when you don't have Apple Developer certs yet)
# ------------------------------------------------------------------
WALLETWALLET_API_KEY=

# ------------------------------------------------------------------
# Option 2: Self-hosted Apple Wallet PassKit signing (takes priority if set)
# Keep private keys outside git & web root.
# ------------------------------------------------------------------
APPLE_PASS_TYPE_ID=pass.az.sarkhan.card
APPLE_TEAM_ID=YOUR_10_CHAR_TEAM_ID
APPLE_PASS_SERIAL_NUMBER=sarkhan-babayev-digital-card-v1

# Option A: PEM certificate + private key
APPLE_PASS_CERTIFICATE_PATH=/etc/sarkhan-wallet/certs/pass-cert.pem
APPLE_PASS_PRIVATE_KEY_PATH=/etc/sarkhan-wallet/certs/pass-key.pem
APPLE_PASS_CERTIFICATE_PASSWORD=

# Option B: PKCS#12 (.p12) bundle instead of separate PEM cert/key
# APPLE_PASS_P12_PATH=/etc/sarkhan-wallet/certs/pass.p12

# Apple Worldwide Developer Relations (WWDR G4) intermediate certificate
APPLE_WWDR_CERTIFICATE_PATH=/etc/sarkhan-wallet/certs/AppleWWDRCAG4.cer
